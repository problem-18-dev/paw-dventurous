; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Paw-dventurous"
config/description="Game #8 in the Problem 18 challenge. A Crash Bandicoot-inspired game about a dog making their way to get the ultimate snack."
config/version="0.0.1"
run/main_scene="uid://bni0yp1s2pckh"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=360
config/icon="res://icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/log/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://assets/prototype/": "yellow",
"res://core/": "green",
"res://resources/": "red",
"res://scenes/": "blue",
"res://testing/": "teal"
}

