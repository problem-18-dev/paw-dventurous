			]
		},
		{
			"uuid": "ff2ac180-b4d9-4d77-9885-94bc113a81b9",
			"title": "[Feat] Base level",
			"description": "All levels should adhere to a specific, fixed width.\n\nA level is linear, and long.\n\nA camera should be present in each level, adjustable and accessible by the main game. The camera follows the player, axis Y and X are locked.",
			"category": "26929272-0dbe-4941-9cf2-829cf0257dce",
			"steps": [
				{
					"details": "Camera setup and access",
					"done": true
				},
				{
					"details": "Settle fixed level width",
					"done": true
				}
			]
		},
		{
			"uuid": "23b77b67-4ba6-4ffb-ad0c-da6e63706bc2",
			"title": "[Feat] Pickuppables",
			"description": "A pickuppable is a floating, spinning item that can be picked up by the player by walking through it.\n\nDog treats are an equvalient of coins, better collection results in a level's better result.\n\nTennis balls are special coins (3 per level) that equaly aid a better result.",
			"category": "26929272-0dbe-4941-9cf2-829cf0257dce",
			"steps": [
				{
					"details": "Dog treats",
					"done": true
				},
				{
					"details": "Tennis balls",
					"done": true
				}
			]
		},
		{
			"uuid": "03713ae0-0a59-4222-bcc2-87b5e1f706c9",
			"title": "[Feat] Enemies",
			"description": "Chase enemy is an enemy that wanders around, and when player is close enough, the enemy will approach the player to damage.\n\nPatrol enemy is an enemy that consistently moves between two points, regardless of the player's position.",
			"category": "26929272-0dbe-4941-9cf2-829cf0257dce",
			"steps": [
				{
					"details": "Patrol enemy",
					"done": true
				},
				{
					"details": "Chase enemy",
					"done": true
				},
				{
					"details": "Turn state",
					"done": true
				}
			]
		},
		{
			"uuid": "65e02326-fa63-4d47-b058-38376fec3306",
			"title": "[Feat] Level goal",
			"description": "Each level's goal is to reach the end. At the end there should be a small platform that the player will be automatically positioned onto when the area is reached. A small celebration will then be displayed before continuing on to the summary.",
			"category": "26929272-0dbe-4941-9cf2-829cf0257dce",
